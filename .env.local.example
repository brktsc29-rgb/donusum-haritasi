# Supabase — Supabase Dashboard > Settings > API bölümünden alınır
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Maps — Google Cloud Console > APIs & Services > Credentials
# Etkinleştirilmesi gereken API'lar:
#   - Maps JavaScript API
#   - Geocoding API (ileride)
#   - Places API (ileride)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Resend — E-posta gönderimi için (Faz 4'te kullanılacak)
RESEND_API_KEY=re_...

# Uygulamanın base URL'i (Vercel deploy sonrası otomatik set edilir)
NEXT_PUBLIC_APP_URL=http://localhost:3000
